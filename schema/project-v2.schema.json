{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caibi.app/schema/project-v2.schema.json",
  "title": "CAIBI Public Project Dataset v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "generatedAt", "records"],
  "properties": {
    "contractVersion": { "const": "2.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "records": { "type": "array", "items": { "$ref": "#/$defs/project" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "kind"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "kind": { "enum": ["creator", "repository", "documentation", "manufacturer", "article", "video", "other"] }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "alt": { "type": "string" },
        "sourceUrl": { "type": "string", "format": "uri" },
        "rightsBasis": { "type": "string" }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "type": { "enum": ["repo", "docs", "files", "article", "video", "community", "other"] },
        "note": { "type": "string" }
      }
    },
    "comparisonSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "url"],
      "properties": {
        "region": { "enum": ["UK", "US", "GLOBAL"] },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    },
    "costGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "basis", "confidence", "checkedOn", "explanation", "includes", "excludes"],
      "properties": {
        "label": { "enum": ["Source cost", "CAIBI estimate", "Planning cost"] },
        "gbp": { "type": "string", "minLength": 1 },
        "usd": { "type": "string", "minLength": 1 },
        "basis": { "enum": ["source-total", "source-partial", "caibi-estimate", "variable"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "checkedOn": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string", "minLength": 1 },
        "includes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "excludes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "anyOf": [
        { "required": ["gbp"] },
        { "required": ["usd"] }
      ]
    },
    "buildVsBuy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "outcome", "headline", "note"],
      "properties": {
        "status": { "enum": ["priced", "incomplete", "no-close-equivalent", "not-like-for-like"] },
        "outcome": { "enum": ["build-costs-less", "buy-costs-less", "unclear", "not-applicable"] },
        "headline": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 },
        "boughtAlternative": { "type": "string", "minLength": 1 },
        "boughtGbp": { "type": "string", "minLength": 1 },
        "boughtUsd": { "type": "string", "minLength": 1 },
        "differenceGbp": { "type": "string", "minLength": 1 },
        "differenceUsd": { "type": "string", "minLength": 1 },
        "differenceLabel": { "enum": ["Potential cash saving", "Buying is cheaper by"] },
        "checkedOn": { "type": "string", "minLength": 1 },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/comparisonSource" } }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "reason", "costGuidance", "buildVsBuy", "evidenceStatus", "aiCanHelp", "aiCantDo"],
      "properties": {
        "verdict": { "enum": ["RECOMMENDED", "WORTH CONSIDERING", "FOR THE BUILD", "BUY INSTEAD", "NOT READY"] },
        "reason": { "type": "string", "minLength": 1 },
        "cost": { "type": "string" },
        "costGuidance": { "$ref": "#/$defs/costGuidance" },
        "buildVsBuy": { "$ref": "#/$defs/buildVsBuy" },
        "time": { "type": "string" },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "aiLeverage": { "type": "integer", "minimum": 1, "maximum": 5 },
        "evidenceStatus": { "type": "string", "minLength": 1 },
        "aiCanHelp": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "aiCantDo": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "mainCatch": { "type": "string" },
        "checkedOn": { "type": "string" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name", "category", "summary", "source", "pipelineStage", "tags"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "pipelineStage": { "enum": ["FOUND", "REVIEWED SOURCE", "ASSESSMENT CANDIDATE", "ASSESSED"] },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "media": { "type": "array", "items": { "$ref": "#/$defs/media" } },
        "assessment": { "$ref": "#/$defs/assessment" },
        "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "lastChecked": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "pipelineStage": { "const": "ASSESSED" } }, "required": ["pipelineStage"] },
          "then": { "required": ["assessment"] }
        },
        {
          "if": { "not": { "properties": { "pipelineStage": { "const": "ASSESSED" } }, "required": ["pipelineStage"] } },
          "then": { "not": { "required": ["assessment"] } }
        }
      ]
    }
  }
}
